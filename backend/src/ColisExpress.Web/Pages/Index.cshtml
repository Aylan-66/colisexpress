@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
    var isAuth = User.Identity?.IsAuthenticated ?? false;
}

<!-- HERO avec header visuel -->
<section class="home-hero">
    <div class="home-hero-inner">
        <div class="home-hero-badge">France → Maghreb</div>
        <h1 class="home-hero-title">
            Envoyez vos colis <span class="text-accent">simplement</span><br>vers le Maghreb
        </h1>
        <p class="home-hero-sub">
            Confiez vos colis à des transporteurs vérifiés. Suivi digital de bout en bout, de la France vers l'Algérie, le Maroc et la Tunisie.
        </p>
        <div class="flex gap-2 items-center" style="justify-content:center;flex-wrap:wrap;">
            <a class="web-btn accent" asp-page="/Client/Recherche">Rechercher un transporteur →</a>
            <a class="web-btn outline-light" asp-page="/Client/Suivi">Suivre un colis</a>
        </div>
    </div>
</section>

<section class="web-page">
    <!-- BLOC MARKETING -->
    <div class="home-features">
        <div class="home-feature">
            <div class="home-feature-icon">🔒</div>
            <h3>Envoi & retrait sécurisés</h3>
            <p>Code de retrait à 4 chiffres et QR code. Votre colis n'est remis qu'à la bonne personne.</p>
        </div>
        <div class="home-feature">
            <div class="home-feature-icon">📍</div>
            <h3>Suivi du colis en direct</h3>
            <p>Une timeline en temps réel, de la prise en charge à la livraison, à chaque étape du trajet.</p>
        </div>
        <div class="home-feature">
            <div class="home-feature-icon">💶</div>
            <h3>Tarifs transparents</h3>
            <p>Comparez les transporteurs, des prix clairs et une réservation en ligne en quelques clics.</p>
        </div>
    </div>

    <!-- ÉTAPES -->
    <h2 class="home-section-title">Comment ça marche</h2>
    <div class="kpi-grid">
        <div class="kpi-card text-center">
            <div class="kpi-label">Étape 1</div>
            <div style="font-size:32px;margin:8px 0;">🔎</div>
            <div style="font-weight:700;color:var(--gray-800);">Cherchez</div>
            <div class="kpi-hint">Ville de départ et destination</div>
        </div>
        <div class="kpi-card text-center">
            <div class="kpi-label">Étape 2</div>
            <div style="font-size:32px;margin:8px 0;">📦</div>
            <div style="font-weight:700;color:var(--gray-800);">Réservez</div>
            <div class="kpi-hint">Transporteur vérifié, prix fixe</div>
        </div>
        <div class="kpi-card text-center">
            <div class="kpi-label">Étape 3</div>
            <div style="font-size:32px;margin:8px 0;">📍</div>
            <div style="font-weight:700;color:var(--gray-800);">Suivez</div>
            <div class="kpi-hint">Timeline en temps réel</div>
        </div>
        <div class="kpi-card text-center">
            <div class="kpi-label">Étape 4</div>
            <div style="font-size:32px;margin:8px 0;">✅</div>
            <div style="font-weight:700;color:var(--gray-800);">Livré</div>
            <div class="kpi-hint">Retrait par code sécurisé</div>
        </div>
    </div>

    <!-- AVIS -->
    <h2 class="home-section-title" id="avis">Ils nous font confiance</h2>
    <div class="home-reviews">
        <div class="home-review">
            <div class="home-review-stars">★★★★★</div>
            <p>"Colis envoyé à ma famille à Alger, suivi en direct et récupéré en 3 jours. Parfait."</p>
            <div class="home-review-author">— Yacine, Paris</div>
        </div>
        <div class="home-review">
            <div class="home-review-stars">★★★★★</div>
            <p>"Tarif clair dès le départ, pas de surprise. Le transporteur était très sérieux."</p>
            <div class="home-review-author">— Nadia, Lyon</div>
        </div>
        <div class="home-review">
            <div class="home-review-stars">★★★★☆</div>
            <p>"Pratique de choisir un point relais proche de chez moi. Je recommande."</p>
            <div class="home-review-author">— Sofiane, Marseille</div>
        </div>
    </div>

    <!-- QUI SOMMES-NOUS -->
    <div class="home-about" id="qui-sommes-nous">
        <h2 class="home-section-title" style="margin-top:0;">Qui sommes-nous</h2>
        <p>
            Colis Express met en relation des particuliers qui souhaitent envoyer un colis vers le Maghreb
            avec des transporteurs vérifiés effectuant régulièrement le trajet. Notre mission : rendre l'envoi
            de colis France → Maghreb simple, sûr et transparent, grâce au suivi digital, aux points relais
            partenaires et à des tarifs clairs affichés avant toute réservation.
        </p>
        <div style="margin-top:20px;">
            <a class="web-btn accent" asp-page="/Client/Recherche">Commencer un envoi →</a>
        </div>
    </div>
</section>
