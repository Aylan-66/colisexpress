@page "/reservation"
@model ColisExpress.Web.Pages.Client.ReservationModel
@{
    ViewData["Title"] = "Réservation";
}

<section class="web-page">
    <h1>Finaliser votre réservation</h1>
    <p class="subtitle">Remplissez les informations du destinataire et du colis.</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="web-alert error">@Model.Error</div>
    }

    @if (Model.Offre is not null)
    {
        <div class="web-alert info" style="display:flex;gap:10px;align-items:flex-start;">
            <span style="font-size:18px;">⚠️</span>
            <div>
                <strong>Règles à respecter :</strong> poids maximum <strong>@Model.Offre.CapaciteMaxPoids kg</strong> par colis sur ce trajet.
                Produits interdits : armes, explosifs, drogues, liquides inflammables, batteries lithium, gaz sous pression, animaux vivants, argent liquide, matières radioactives.
            </div>
        </div>
    }

    <div class="grid-2">
        <form method="post" asp-route-trajetId="@Model.TrajetId" asp-route-poids="@Model.Poids" asp-route-fragile="@Model.Fragile" asp-route-urgent="@Model.Urgent" asp-route-segDepart="@Model.SegDepart" asp-route-segArrivee="@Model.SegArrivee">
            <div class="web-card">
                <h2>Destinataire</h2>
                <div class="web-field-row">
                    <div class="web-field">
                        <label class="web-field-label">Nom complet</label>
                        <input class="web-field-input" asp-for="Input.NomDestinataire" required />
                    </div>
                    <div class="web-field">
                        <label class="web-field-label">Téléphone</label>
                        <input class="web-field-input" asp-for="Input.TelephoneDestinataire" required />
                    </div>
                </div>
                <div class="web-field">
                    <label class="web-field-label">Ville / Wilaya</label>
                    <input class="web-field-input" asp-for="Input.VilleDestinataire" required />
                </div>
            </div>

            <div class="web-card">
                <h2>Détails du colis</h2>
                <div class="web-field">
                    <label class="web-field-label">Description du contenu</label>
                    <textarea class="web-field-textarea" asp-for="Input.DescriptionContenu" required></textarea>
                </div>
                <div class="web-field-row">
                    <div class="web-field">
                        <label class="web-field-label">Poids déclaré (kg)</label>
                        <input id="f-poids" type="number" step="0.1" min="0.1"
                               max="@(Model.Offre?.PoidsMaxColisKg?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) ?? Model.Offre?.CapaciteMaxPoids.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))"
                               class="web-field-input" asp-for="Input.PoidsDeclare" required />
                        @if (Model.Offre is not null)
                        {
                            var maxKg = Model.Offre.PoidsMaxColisKg ?? Model.Offre.CapaciteMaxPoids;
                            <div class="text-muted" style="font-size:11px;margin-top:4px;">Max @maxKg kg par colis</div>
                        }
                    </div>
                </div>
                <div class="web-field-row">
                    <div class="web-field">
                        <label class="web-field-label">Longueur (cm)</label>
                        <input id="f-l" type="number" min="1" class="web-field-input" asp-for="Input.LongueurCm" required />
                        @if (Model.Offre?.LongueurMaxColisCm is int l) { <div class="text-muted" style="font-size:11px;margin-top:4px;">Max @l cm</div> }
                    </div>
                    <div class="web-field">
                        <label class="web-field-label">Largeur (cm)</label>
                        <input id="f-la" type="number" min="1" class="web-field-input" asp-for="Input.LargeurCm" required />
                        @if (Model.Offre?.LargeurMaxColisCm is int la) { <div class="text-muted" style="font-size:11px;margin-top:4px;">Max @la cm</div> }
                    </div>
                    <div class="web-field">
                        <label class="web-field-label">Hauteur (cm)</label>
                        <input id="f-h" type="number" min="1" class="web-field-input" asp-for="Input.HauteurCm" required />
                        @if (Model.Offre?.HauteurMaxColisCm is int h) { <div class="text-muted" style="font-size:11px;margin-top:4px;">Max @h cm</div> }
                    </div>
                </div>
                <div class="web-field">
                    <label class="web-field-label">Valeur déclarée (€)</label>
                    <input type="number" step="0.01" class="web-field-input" asp-for="Input.ValeurDeclaree" required />
                </div>
                <div class="web-field">
                    <label class="web-field-label">Instructions particulières (optionnel)</label>
                    <textarea class="web-field-textarea" asp-for="Input.InstructionsParticulieres"></textarea>
                </div>
            </div>

            <button type="submit" class="web-btn accent full">Continuer vers le paiement →</button>
        </form>

        <div>
            @if (Model.Offre is not null)
            {
                <div class="web-card">
                    <h3>Transporteur</h3>
                    <div class="flex gap-4 items-center mb-4">
                        <div style="width:44px;height:44px;border-radius:50%;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;">
                            @Model.Offre.Initiales
                        </div>
                        <div>
                            <div style="font-weight:800;">@Model.Offre.NomTransporteur</div>
                            <div style="font-size:12px;color:var(--gray-500);">⭐ @Model.Offre.NoteMoyenne.ToString("0.0") (@Model.Offre.NombreAvis avis)</div>
                        </div>
                    </div>
                    <div style="font-size:12px;color:var(--gray-500);">
                        @Model.Offre.VilleDepart → @Model.Offre.VilleArrivee<br>
                        Départ : @Model.Offre.DateDepart.ToString("dd MMM yyyy")<br>
                        Véhicule : @Model.Offre.TypeVehicule
                    </div>
                </div>

                @if (Model.Offre.Tarif is not null)
                {
                    var tt = Model.Offre.Tarif;
                    <style>
                        .palier { padding:10px 12px; border:1px solid #e5e7eb; border-radius:8px; margin-bottom:6px; transition:.2s; }
                        .palier.actif { border-color:#1B4965; background:#F0F6FA; box-shadow:0 1px 4px rgba(27,73,101,.15); }
                        .palier-titre { font-weight:800; font-size:13px; }
                        .palier-detail { font-size:12px; color:#6b7280; margin-top:2px; }
                        .badge-actif { display:inline-block; background:#1B4965; color:#fff; font-size:10px; font-weight:800; padding:2px 6px; border-radius:4px; margin-left:6px; }
                        @@keyframes flash { 0% { background:#FEF3C7; } 100% { background:transparent; } }
                        .price-flash { animation: flash 0.5s ease-out; }
                    </style>

                    <div class="web-card">
                        <h3>💰 Comment le prix est calculé</h3>
                        <div style="font-size:12px;color:var(--gray-500);margin-bottom:10px;">Tarif appliqué : <strong>@tt.Nom</strong></div>

                        <div id="palier-std" class="palier">
                            <div class="palier-titre">📦 Standard <span class="badge-actif" style="display:none;">ACTUEL</span></div>
                            <div class="palier-detail">@tt.PrixAuKiloStandard €/kg, pour les colis jusqu'à <strong>@tt.SeuilStandardKg kg</strong></div>
                        </div>
                        <div id="palier-lourd" class="palier">
                            <div class="palier-titre">🏋️ Lourd <span class="badge-actif" style="display:none;">ACTUEL</span></div>
                            <div class="palier-detail">Forfait <strong>@tt.ForfaitLourd €</strong> + <strong>@tt.PrixAuKiloLourd €/kg</strong> au-delà de @tt.SeuilStandardKg kg</div>
                        </div>
                        <div id="palier-hg" class="palier">
                            <div class="palier-titre">📐 Hors gabarit <span class="badge-actif" style="display:none;">ACTUEL</span></div>
                            <div class="palier-detail">Forfait <strong>@tt.ForfaitHorsGabarit €</strong> + <strong>@tt.PrixAuKiloHorsGabarit €/kg</strong> si une dimension dépasse <strong>@tt.LongueurMaxStandardCm × @tt.LargeurMaxStandardCm × @tt.HauteurMaxStandardCm cm</strong></div>
                        </div>
                    </div>

                    <div class="web-card" id="calcul-detail" style="background:#F0F6FA;border:1px solid #1B4965;">
                        <h3 style="color:#1B4965;">🧮 Votre colis</h3>
                        <div id="calcul-formule" style="font-family:monospace;font-size:13px;color:#1B4965;line-height:1.8;"></div>
                        <div id="calcul-warning" style="display:none;background:#FEE2E2;color:#991B1B;padding:8px 10px;border-radius:6px;margin-top:8px;font-size:12px;font-weight:700;"></div>
                    </div>
                }

                <div class="web-card">
                    <h3>Récapitulatif</h3>
                    <div class="flex justify-between mb-2" style="font-size:13px;">
                        <span class="text-muted">Transport</span>
                        <span id="prix-transport" style="font-weight:700;">@Model.Offre.Prix.ToString("0.00") €</span>
                    </div>
                    <div class="flex justify-between mb-2" style="font-size:13px;">
                        <span class="text-muted">Frais de service</span>
                        <span style="font-weight:700;">5,00 €</span>
                    </div>
                    <hr style="border:none;border-top:1px solid var(--gray-200);margin:12px 0;" />
                    <div class="flex justify-between" style="font-size:22px;font-weight:800;color:var(--primary);">
                        <span>Total</span>
                        <span id="prix-total">@((Model.Offre.Prix + 5m).ToString("0.00")) €</span>
                    </div>
                    @if (Model.Offre.Tarif is not null)
                    {
                        <div class="text-muted" style="font-size:11px;margin-top:6px;">↻ Prix recalculé automatiquement quand vous modifiez poids ou dimensions</div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@if (Model.Offre?.Tarif is not null)
{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var t = Model.Offre.Tarif;
    var maxL = Model.Offre.LongueurMaxColisCm;
    var maxLa = Model.Offre.LargeurMaxColisCm;
    var maxH = Model.Offre.HauteurMaxColisCm;
    var maxKg = Model.Offre.PoidsMaxColisKg;
    <script>
        (function () {
            const tarif = {
                std: @t.PrixAuKiloStandard.ToString(inv),
                seuil: @t.SeuilStandardKg.ToString(inv),
                forfaitL: @t.ForfaitLourd.ToString(inv),
                prixL: @t.PrixAuKiloLourd.ToString(inv),
                forfaitHG: @t.ForfaitHorsGabarit.ToString(inv),
                prixHG: @t.PrixAuKiloHorsGabarit.ToString(inv),
                Lmax: @t.LongueurMaxStandardCm,
                lmax: @t.LargeurMaxStandardCm,
                Hmax: @t.HauteurMaxStandardCm
            };
            const limits = {
                L: @(maxL?.ToString() ?? "null"),
                la: @(maxLa?.ToString() ?? "null"),
                H: @(maxH?.ToString() ?? "null"),
                kg: @(maxKg?.ToString(inv) ?? "null")
            };
            const FRAIS = 5;
            const $ = id => document.getElementById(id);
            const poids = $('f-poids'), fL = $('f-l'), fla = $('f-la'), fH = $('f-h');
            const transp = $('prix-transport'), total = $('prix-total');
            const pStd = $('palier-std'), pLourd = $('palier-lourd'), pHg = $('palier-hg');
            const formule = $('calcul-formule');
            const warning = $('calcul-warning');

            function setActif(palier) {
                [pStd, pLourd, pHg].forEach(el => {
                    el.classList.remove('actif');
                    el.querySelector('.badge-actif').style.display = 'none';
                });
                if (palier) {
                    palier.classList.add('actif');
                    palier.querySelector('.badge-actif').style.display = 'inline-block';
                }
            }

            function fmt(n) { return n.toFixed(2).replace('.', ',') + ' €'; }

            function recalc() {
                const p = parseFloat(poids.value);
                const L = parseInt(fL.value);
                const la = parseInt(fla.value);
                const H = parseInt(fH.value);

                // Vérifs limites strictes (refus auto à la création)
                const warns = [];
                if (limits.kg !== null && p > limits.kg) warns.push(`Poids ${p} kg dépasse la limite stricte de ${limits.kg} kg → refus auto`);
                if (limits.L !== null && L > limits.L) warns.push(`Longueur ${L} cm dépasse la limite stricte de ${limits.L} cm → refus auto`);
                if (limits.la !== null && la > limits.la) warns.push(`Largeur ${la} cm dépasse la limite stricte de ${limits.la} cm → refus auto`);
                if (limits.H !== null && H > limits.H) warns.push(`Hauteur ${H} cm dépasse la limite stricte de ${limits.H} cm → refus auto`);

                if (warns.length > 0) {
                    warning.style.display = 'block';
                    warning.innerHTML = '⚠ ' + warns.join('<br>⚠ ');
                } else {
                    warning.style.display = 'none';
                }

                if (!p || p <= 0 || !L || !la || !H) {
                    formule.innerHTML = '<span style="color:#6b7280;">Saisissez le poids et les 3 dimensions pour voir le prix calculé.</span>';
                    return;
                }

                const horsGabarit = (L > tarif.Lmax) || (la > tarif.lmax) || (H > tarif.Hmax);
                let prix, palierActif, formuleStr, raison;

                if (horsGabarit) {
                    prix = tarif.forfaitHG + tarif.prixHG * p;
                    palierActif = pHg;
                    raison = `Une dimension dépasse ${tarif.Lmax}×${tarif.lmax}×${tarif.Hmax} cm`;
                    formuleStr = `${tarif.forfaitHG} € (forfait) + ${tarif.prixHG} €/kg × ${p} kg = <strong>${fmt(prix)}</strong>`;
                } else if (p > tarif.seuil) {
                    prix = tarif.forfaitL + tarif.prixL * p;
                    palierActif = pLourd;
                    raison = `Poids ${p} kg supérieur au seuil de ${tarif.seuil} kg`;
                    formuleStr = `${tarif.forfaitL} € (forfait) + ${tarif.prixL} €/kg × ${p} kg = <strong>${fmt(prix)}</strong>`;
                } else {
                    prix = tarif.std * p;
                    palierActif = pStd;
                    raison = `Poids ${p} kg ≤ ${tarif.seuil} kg et dimensions ≤ ${tarif.Lmax}×${tarif.lmax}×${tarif.Hmax} cm`;
                    formuleStr = `${tarif.std} €/kg × ${p} kg = <strong>${fmt(prix)}</strong>`;
                }

                setActif(palierActif);
                formule.innerHTML = `
                    <div style="color:#6b7280;font-size:12px;font-family:inherit;">Pourquoi ce palier ?</div>
                    <div style="margin-bottom:8px;font-size:12px;font-family:inherit;">${raison}</div>
                    <div style="color:#6b7280;font-size:12px;font-family:inherit;">Calcul :</div>
                    <div>${formuleStr}</div>
                    <div style="margin-top:8px;font-size:12px;font-family:inherit;color:#6b7280;">+ 5,00 € frais de service = <strong>${fmt(prix + FRAIS)} TTC</strong></div>
                `;

                transp.textContent = fmt(prix);
                total.textContent = fmt(prix + FRAIS);

                // Flash animation
                transp.classList.remove('price-flash');
                total.classList.remove('price-flash');
                void transp.offsetWidth; // force reflow
                transp.classList.add('price-flash');
                total.classList.add('price-flash');
            }

            [poids, fL, fla, fH].forEach(el => el && el.addEventListener('input', recalc));
            recalc();
        })();
    </script>
}
